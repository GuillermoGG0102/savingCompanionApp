{
  "expo": {
    "name": "Saving Companion",
    "slug": "saving-companiom-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "savingcompanion",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tnksteam.savingcompanion",
      "adaptiveIcon": {
        "backgroundColor": "#111917",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/lockup-vertical-transparent.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0e46a222-77ad-4356-980f-81810373d35e"
      }
    },
    "owner": "tnks-team"
  }
}
